generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  FINANCE_OFFICER
  CLIENT_MANAGER
  CONTRACTOR
}

enum ContractorStatus {
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum RateType {
  HOURLY
  RETAINER
  PER_PROJECT
}

enum Currency {
  PHP
  USD
  EUR
  AUD
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
}

enum PayFrequency {
  MONTHLY
  SEMI_MONTHLY
}

enum RetainerBasis {
  PER_MONTH
  PER_PERIOD
}

enum ProjectPayMode {
  ON_COMPLETION
  MILESTONE
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(FINANCE_OFFICER)
  contractor   Contractor?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Contractor {
  id               String                    @id @default(cuid())
  userId           String?                   @unique
  user             User?                     @relation(fields: [userId], references: [id])
  name             String
  email            String                    @unique
  phone            String?
  taxId            String?
  status           ContractorStatus          @default(ACTIVE)
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  paymentDetails   ContractorPaymentDetail[]
  engagements      Engagement[]
  timesheets       Timesheet[]
  payrollLineItems PayrollLineItem[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model ContractorPaymentDetail {
  id            String     @id @default(cuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  method        String
  accountName   String
  accountNumber String
  bankName      String?
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
}

model Client {
  id              String       @id @default(cuid())
  name            String
  email           String?
  contactPerson   String?
  billingCurrency Currency     @default(PHP)
  status          ClientStatus @default(ACTIVE)
  notes           String?
  engagements     Engagement[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Engagement {
  id               String            @id @default(cuid())
  contractorId     String
  contractor       Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title            String?
  rateType         RateType
  retainerBasis    RetainerBasis     @default(PER_MONTH)
  projectPayMode   ProjectPayMode    @default(ON_COMPLETION)
  status           String            @default("active")
  startDate        DateTime
  endDate          DateTime?
  rates            Rate[]
  timesheets       Timesheet[]
  milestones       Milestone[]
  payrollLineItems PayrollLineItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Rate {
  id            String     @id @default(cuid())
  engagementId  String
  engagement    Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  amount        Decimal    @db.Decimal(10, 2)
  currency      Currency   @default(PHP)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
}

model Milestone {
  id           String           @id @default(cuid())
  engagementId String
  engagement   Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title        String
  amount       Decimal          @db.Decimal(12, 2)
  currency     Currency         @default(PHP)
  completedAt  DateTime?
  lineItem     PayrollLineItem?
  createdAt    DateTime         @default(now())
}

model Timesheet {
  id                String           @id @default(cuid())
  engagementId      String
  engagement        Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  contractorId      String
  contractor        Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  date              DateTime
  hours             Decimal?         @db.Decimal(5, 2)
  description       String?
  status            TimesheetStatus  @default(SUBMITTED)
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  // Set once the timesheet is in a payroll run, which is what stops it being paid twice
  payrollLineItemId String?
  payrollLineItem   PayrollLineItem? @relation(fields: [payrollLineItemId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@unique([engagementId, date])
}

model PayrollSettings {
  id           String       @id @default("default")
  payFrequency PayFrequency @default(MONTHLY)
  updatedAt    DateTime     @updatedAt
}

model PayrollPeriod {
  id        String       @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  // Copied from settings when the period is created, so later changes leave it alone
  frequency PayFrequency @default(MONTHLY)
  status    String       @default("open")
  runs      PayrollRun[]
  createdAt DateTime     @default(now())

  @@unique([startDate, endDate])
}

model PayrollRun {
  id              String            @id @default(cuid())
  payrollPeriodId String            @unique
  payrollPeriod   PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  status          PayrollRunStatus  @default(DRAFT)
  lineItems       PayrollLineItem[]
  warnings        Json              @default("[]")
  generatedAt     DateTime          @default(now())
  finalizedAt     DateTime?
}

model PayrollLineItem {
  id             String      @id @default(cuid())
  payrollRunId   String
  payrollRun     PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  engagementId   String
  engagement     Engagement  @relation(fields: [engagementId], references: [id])
  contractorId   String
  contractor     Contractor  @relation(fields: [contractorId], references: [id])
  rateType       RateType
  hours          Decimal?    @db.Decimal(6, 2)
  rateAmount     Decimal     @db.Decimal(10, 2)
  currency       Currency    @default(PHP)
  totalAmount    Decimal     @db.Decimal(12, 2)
  // PHP per 1 unit of currency. Saved on the item so finalized runs never change.
  exchangeRate   Decimal?    @db.Decimal(12, 6)
  totalAmountPhp Decimal?    @db.Decimal(14, 2)
  notes          String?
  timesheets     Timesheet[]
  // Unique, so the database itself refuses to pay a milestone twice
  milestoneId    String?     @unique
  milestone      Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
}